# Production build ki values. Yeh JAAN BOOJH KAR commit hoti hain —
# dono public hain, koi raaz nahi, aur inke baghair static export
# mein form ka pata hi ghayab ho jata hai.
#
# `next build` inhe khud utha leta hai. Koi machine .env.local ke
# baghair build kare tab bhi enquiry form sahi API par jayega.

NEXT_PUBLIC_SITE_URL=https://nextbite.com.au
NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://nextbiteapi.webappconsulting.com.au/api/enquiries
